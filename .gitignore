# Local Python/MCP runtime: never commit installed dependencies or cache
.agents/skills/jechulok-submission/.venv/
.agents/skills/jechulok-submission/**/__pycache__/
.agents/skills/jechulok-submission/**/*.pyc

# Local approved job journal, never share private output paths
.jechulok-jobs/
**/.jechulok-jobs/
# Temporary staging files may contain sensitive documents
.*.jechulok-*.jpg
.*.jechulok-*.jpeg
.*.jechulok-*.pdf

# Private real-world evaluation corpus and local reports (never commit)
.agents/skills/jechulok-submission/private-evaluation/
**/*.notice-eval-private.jsonl
**/*.notice-eval-private.json

# v2.0 local release archives and interrupted extraction staging
jechulok-agent-skill-v*.zip
jechulok-agent-skill-v*.sha256
.jechulok-release-*/

# Private user-selected v2.5 feedback records; never commit actual responses
*.feedback-v25.json
.agents/skills/jechulok-submission/private-feedback/
